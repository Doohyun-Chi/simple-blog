# Copy to config/application-local.properties (gitignored) and fill in.
# Loaded by: ./gradlew bootRun --args='--spring.profiles.active=local'
spring.datasource.username=root
spring.datasource.password=change-me

# Google sign-in: create an OAuth client (type "Web application") in Google Cloud Console, add the redirect URI
# http://localhost:8080/public/auth/google/callback and the JavaScript origin http://localhost:5173, then copy its values.
# Leave these out and the Google sign-in is simply not available (/public/auth/google answers 404).
simpleblog.auth.google.client-id=<client id>.apps.googleusercontent.com
simpleblog.auth.google.client-secret=<client secret>
# Where the browser returns after signing in: the frontend's address ('' means the same origin as the backend).
simpleblog.auth.frontend-url=http://localhost:5173

# Where uploaded images are stored (created on the first upload). Defaults to ./media when left out.
simpleblog.media.directory=/path/to/media
