# Used by `npm run build`. Empty means the API is served from the same origin as the FE.
# Set it to an absolute URL (for example https://api.example.com) when the backend lives elsewhere.
VITE_API_BASE_URL=

# Google AdSense. The publisher ID is public (it is in every page that shows an ad). Ads show only in production builds,
# and a position shows one only when its ad unit ID (data-ad-slot, from the AdSense console) is filled in below.
VITE_ADSENSE_CLIENT=ca-pub-4734439601791780
VITE_ADSENSE_SLOT_TOP=7229859885
VITE_ADSENSE_SLOT_BOTTOM=8818660767
VITE_ADSENSE_SLOT_ASIDE=1063072635
