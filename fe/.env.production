# Used by `npm run build`. The frontend is served at https://www.chidoo.me and the backend at https://blog.chidoo.me, so the API
# base is absolute (leave it empty only when both share one origin). The backend's prod profile allows this FE origin.
VITE_API_BASE_URL=https://blog.chidoo.me

# Google AdSense. The publisher ID is public (it is in every page that shows an ad). Ads show only in production builds,
# and a position shows one only when its ad unit ID (data-ad-slot, from the AdSense console) is filled in below.
VITE_ADSENSE_CLIENT=ca-pub-4734439601791780
VITE_ADSENSE_SLOT_POST=3412391033
VITE_ADSENSE_SLOT_ASIDE=1063072635

# Google Analytics 4 measurement ID (G-XXXXXXXXXX) of the production data stream. It is public. Empty turns analytics off.
VITE_GA_MEASUREMENT_ID=G-W6NCGPQLE2
