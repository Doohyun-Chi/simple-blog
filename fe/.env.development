# Used by `npm run dev`. The backend runs locally with --spring.profiles.active=local,
# which allows CORS from any localhost port.
VITE_API_BASE_URL=http://localhost:8080

# Google Analytics 4. Use the measurement ID (G-XXXXXXXXXX) of a separate development property or data stream so local traffic
# stays out of the production reports; events then show up in GA's DebugView. Empty turns analytics off.
VITE_GA_MEASUREMENT_ID=G-XVVZR2KJ7M
